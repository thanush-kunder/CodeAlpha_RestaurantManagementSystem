            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Burger\",\n  \"description\": \"Delicious beef burger\",\n  \"category\": \"main\",\n  \"price\": 12.99,\n  \"preparationTime\": 20,\n  \"ingredients\": [\n    { \"name\": \"Beef Patty\", \"quantity\": 1 },\n    { \"name\": \"Bun\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"]
            }
